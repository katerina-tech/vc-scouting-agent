# ---------------------------------------------------------------------------
# VC Startup Scouting Agent — environment configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# The application runs WITHOUT any of these set: it falls back to fully
# deterministic analysis and simply disables LLM-written prose.
# ---------------------------------------------------------------------------

# --- LLM (optional) --------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works.
#   OpenAI      -> https://api.openai.com/v1
#   OpenRouter  -> https://openrouter.ai/api/v1
#   Together    -> https://api.together.xyz/v1
#   Local vLLM  -> http://localhost:8000/v1
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# --- Storage ---------------------------------------------------------------
# Where the SQLite database lives. Defaults to ./data/vc_scouting.db
VC_DB_PATH=

# --- Web enrichment (optional) --------------------------------------------
# When true, the app may fetch a company's OWN website homepage to read its
# title / meta description. It honours robots.txt and never scrapes
# third-party databases. Anything read this way is recorded as INFERRED,
# never as VERIFIED fact.
ENRICHMENT_FETCH_ENABLED=false
ENRICHMENT_USER_AGENT=vc-scouting-agent/0.1 (+research use; contact: you@example.com)
ENRICHMENT_TIMEOUT=15

# --- Paid data sources (optional, adapters are stubs until configured) -----
# Leave blank unless you actually hold a licence for these APIs.
DEALROOM_API_KEY=
CRUNCHBASE_API_KEY=
